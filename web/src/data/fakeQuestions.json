import { marked } from 'marked';
import { useState } from 'react';

const sampleNotes = [
  {
    topic: 'Algorithms',
    title: 'Dynamic programming patterns',
    content: '# DP checklist\n\n- Identify optimal substructure\n- Check overlapping subproblems\n- Use tabulation or memoization' 
  },
  {
    topic: 'DBMS',
    title: 'Normalization notes',
    content: '## Normal forms\n\n1NF removes repeating groups.\n2NF removes partial dependency.\n3NF removes transitive dependency.'
  }
];

export default function NotesPage() {
  const [query, setQuery] = useState('');
  const filtered = sampleNotes.filter((note) => {
    const haystack = `${note.topic} ${note.title} ${note.content}`.toLowerCase();
    return haystack.includes(query.toLowerCase());
  });

  return (
    <div className="space-y-6">
      <div className="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h1 className="text-2xl font-bold">Notes</h1>
        <input
          value={query}
          onChange={(event) => setQuery(event.target.value)}
          placeholder="Search notes by topic or title"
          className="mt-3 w-full rounded-xl border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700"
        />
      </div>

      <div className="space-y-4">
        {filtered.map((note) => (
          <article key={note.title} className="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <div className="mb-3 flex items-center justify-between gap-3">
              <span className="rounded-full bg-blue-500/10 px-2.5 py-1 text-xs font-semibold text-blue-600 dark:text-blue-300">{note.topic}</span>
              <strong>{note.title}</strong>
            </div>
            <div className="prose prose-slate max-w-none dark:prose-invert" dangerouslySetInnerHTML={{ __html: marked(note.content) }} />
          </article>
        ))}
      </div>
    </div>
  );
}

